 "html": "<section id=\"khas\" class=\"khas\">\n<!-- DASAR RISET: B07/W501; Pemeriksaan gigi dan alamat Terusan Sutami tercatat; detail layanan terbatas. | Sumber: https://caribisnis.id/dokter-gigi/bandung/sukajadi/gigiku-dental-care-suka-imp1 | Diperiksa 2026-10-11. Fakta sekunder diberi penanda konfirmasi; tidak memakai harga pembanding sebagai tarif klinik. -->\n<style>\n#khas{font:inherit;color:var(--ink);background:var(--bg);padding:clamp(20px,4vw,52px);margin-block:32px;border:1px solid var(--line);border-radius:28px;isolation:isolate;overflow-wrap:anywhere}#khas *{box-sizing:border-box}#khas .k-wrap{max-width:1100px;margin:auto}#khas .k-eyebrow{font-size:.78rem;letter-spacing:.13em;text-transform:uppercase;color:var(--gold);font-weight:700;margin:0 0 12px}#khas h2{font:inherit;font-size:clamp(1.65rem,3vw,2.55rem);font-weight:700;line-height:1.15;margin:0 0 16px;max-width:24ch}#khas h3{font:inherit;font-size:1.1rem;font-weight:700;line-height:1.4;margin:0 0 10px}#khas p{line-height:1.65;margin:0 0 15px}#khas .k-intro{max-width:68ch;margin-bottom:24px}#khas .k-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:22px;align-items:start}#khas .k-work,#khas .k-result{min-width:0;background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:24px}#khas .k-result{border-top:4px solid var(--gold)}#khas label{display:block;font-size:.95rem;line-height:1.5;margin:0 0 16px;font-weight:600}#khas input,#khas select,#khas textarea{font:inherit;display:block;width:100%;min-width:0;min-height:46px;border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-top:7px;color:var(--ink);background:var(--bg)}#khas input[type=checkbox]{display:inline-block;width:20px;height:20px;min-height:20px;flex:0 0 20px;margin:2px 10px 0 0;accent-color:var(--gold)}#khas input[type=range]{padding:0;accent-color:var(--gold)}#khas .k-checks label{display:flex;align-items:flex-start;font-weight:400;padding:10px;border:1px solid var(--line);border-radius:10px;margin-bottom:9px}#khas button,#khas .k-wa{font:inherit;color:var(--ink);border:1px solid var(--line);border-radius:12px;background:var(--paper);padding:12px 15px;min-height:46px;cursor:pointer;line-height:1.4;text-decoration:none;max-width:100%;white-space:normal}#khas button:hover,#khas .k-wa:hover{border-color:var(--gold)}#khas button:focus-visible,#khas a:focus-visible,#khas input:focus-visible,#khas select:focus-visible,#khas summary:focus-visible{outline:3px solid var(--gold);outline-offset:3px}#khas button[aria-pressed=true]{border:2px solid var(--gold);background:var(--bg);font-weight:700}#khas .k-choices{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px}#khas .k-choices button{flex:1 1 130px;text-align:left}#khas .k-wa{display:flex;align-items:center;justify-content:center;gap:10px;background:var(--gold);color:var(--ink);font-weight:700;border-color:var(--gold);width:100%;margin-top:18px}#khas .k-wa svg{width:22px;height:22px;flex-shrink:0}#khas .k-result ul{padding-left:20px;line-height:1.65;margin:16px 0}#khas .k-result li{margin-bottom:7px}#khas .k-note{border-left:3px solid var(--gold);padding:12px 14px;background:var(--bg);border-radius:0 10px 10px 0;font-size:.9rem}#khas .k-summary{white-space:pre-wrap;font:inherit;font-size:.9rem;line-height:1.6;margin:12px 0 0;border:1px solid var(--line);border-radius:12px;padding:14px;max-height:240px;overflow:auto}#khas .k-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}#khas .k-actions button{flex:1 1 110px;font-size:.9rem}#khas .k-list{margin-top:18px;padding-left:0;list-style-position:inside}#khas .k-item{display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line);padding:12px 0}#khas .k-item span{min-width:0}#khas .k-item button{font-size:.8rem;padding:8px;min-height:44px}#khas .k-story,#khas .k-route,#khas .k-clock,#khas .k-card{padding:18px;background:var(--bg);border:1px solid var(--line);border-radius:14px;line-height:1.65;margin-bottom:18px}#khas .k-stamps{color:var(--gold);font-weight:700;margin-bottom:18px}#khas .k-status{min-height:24px;font-size:.85rem;line-height:1.5;margin-top:12px}#khas .k-meter{height:10px;background:var(--bg);border:1px solid var(--line);border-radius:10px;overflow:hidden;margin:16px 0}#khas .k-meter span{display:block;height:100%;width:0;background:var(--gold)}#khas details{border-top:1px solid var(--line);margin-top:20px;padding-top:16px;font-size:.85rem;line-height:1.6}#khas summary{cursor:pointer;min-height:44px;padding-block:10px}#khas .k-facts{margin:10px 0;padding-left:18px}#khas .k-foot{font-size:.8rem;margin-top:14px}#khas .k-order{display:flex;gap:8px;align-items:center;margin-bottom:10px;padding:12px;border:1px solid var(--line);border-radius:12px}#khas .k-order span{flex:1}#khas .k-order button{padding:8px;min-width:44px}#khas .k-board{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:16px}#khas .k-board button{text-align:left}#khas .k-proof{font-size:.8rem;line-height:1.55;margin-bottom:18px}#khas [hidden]{display:none!important}@media(max-width:700px){#khas .k-grid{grid-template-columns:minmax(0,1fr)}#khas .k-work,#khas .k-result{padding:18px}#khas{padding:18px;border-radius:20px}#khas .k-board{grid-template-columns:minmax(0,1fr)}}@media(prefers-reduced-motion:reduce){#khas *{scroll-behavior:auto}}\n</style>\n<div class=\"k-wrap\"><p class=\"k-eyebrow\">Gigiku dental care</p><h2>Catatan Gigi Sebelum Bertemu</h2><p class=\"k-intro\">Buat catatan singkat tentang yang kamu rasakan, agar pertanyaan awal lebih jelas. Catatan ini tidak menentukan diagnosis.</p><div class=\"k-grid\"><form class=\"k-work\" aria-label=\"Catatan Gigi Sebelum Bertemu\"><h3>Mulai dari pilihanmu</h3><label>Area yang ingin diceritakan<select data-key=\"area\"><option>Belum tahu</option><option>Gigi depan</option><option>Gigi belakang</option><option>Gusi</option><option>Beberapa area</option></select></label><label>Kapan terasa?<select data-key=\"when\"><option>Belum ada keluhan</option><option>Baru terasa</option><option>Berulang</option><option>Saat makan / minum</option></select></label><label>Sejak kapan / catatan singkat<input data-key=\"memo\" type=\"text\" value=\"\" maxlength=\"160\"></label><button type=\"button\" data-entry>Tambah catatan</button><ol data-diary class=\"k-list\"></ol><p class=\"k-foot\">Isi seperlunya. Pilihan diproses pada halaman ini dan baru dibawa ke WhatsApp saat kamu membuka tombol akhir.</p></form><aside class=\"k-result\" aria-label=\"Ringkasan pilihan\"><h3 data-title>Ringkasan</h3><ul data-lines></ul><p class=\"k-note\" data-note></p><details><summary>Lihat pesan sebelum membuka WhatsApp</summary><div class=\"k-summary\" data-summary></div></details><a class=\"k-wa\" data-wa href=\"https://wa.me/{{WA}}?text=Halo\" target=\"_blank\" rel=\"noopener noreferrer\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M21 11.5a8.5 8.5 0 0 1-8.5 8.5H5l-3 2 1-6a8.5 8.5 0 1 1 18-4.5Z\"/><path d=\"M7 9h10M7 13h7\"/></svg>Konfirmasi ke admin via WhatsApp</a><div class=\"k-actions\"><button type=\"button\" data-copy>Salin ringkasan</button><button type=\"button\" data-reset>Ulangi pilihan</button></div><p data-status class=\"k-status\" role=\"status\" aria-live=\"polite\"></p><p class=\"k-foot\">Ini alat bantu komunikasi. Pemeriksaan, biaya dan rencana perawatan ditentukan bersama tenaga kesehatan.</p></aside></div><details><summary>Informasi yang menjadi dasar fitur</summary><p>Pemeriksaan gigi dan alamat Terusan Sutami tercatat; detail layanan terbatas.</p><p>Informasi yang belum pasti perlu konfirmasi ke admin. Pilihan kamu belum menjadi janji temu.</p></details><noscript><p>Aktifkan JavaScript untuk menyusun ringkasan, atau hubungi admin untuk bertanya langsung.</p></noscript></div>\n<script>\n(()=>{\nconst root=document.currentScript.closest('section');if(!root||root.dataset.ready)return;root.dataset.ready='1';const q=s=>root.querySelector(s),qa=s=>[...root.querySelectorAll(s)],v=k=>q('[data-key=\"'+k+'\"]').value,selected=()=>qa('[data-check]:checked').map(x=>x.value);let pick='',onPick=()=>{},resetExtra=()=>{},message='';const status=t=>q('[data-status]').textContent=t;qa('[data-pick]').forEach(b=>b.addEventListener('click',()=>{pick=b.dataset.pick;qa('[data-pick]').forEach(a=>a.setAttribute('aria-pressed',String(a===b)));onPick(pick);update();}));function update(){const r=compute();q('[data-title]').textContent=r.title;const list=q('[data-lines]');list.replaceChildren(...r.lines.map(t=>{const li=document.createElement('li');li.textContent=t;return li;}));q('[data-note]').textContent=r.note;message='Halo '+\"Gigiku dental care\"+', saya ingin bertanya tentang '+\"Catatan Gigi Sebelum Bertemu\"+'.\\n'+r.lines.join('\\n')+'\\nMohon konfirmasi jadwal, ketersediaan dan informasi yang belum pasti. Terima kasih.';q('[data-summary]').textContent=message;q('[data-wa]').setAttribute('href','https://wa.me/{{WA}}?text='+encodeURIComponent(message));}qa('input,select,textarea').forEach(el=>{el.addEventListener('input',update);el.addEventListener('change',update);});q('[data-reset]').onclick=()=>{q('form').reset();pick='';qa('[data-pick]').forEach(b=>b.setAttribute('aria-pressed','false'));resetExtra();status('Pilihan diulang.');update();};q('[data-copy]').onclick=async()=>{try{await navigator.clipboard.writeText(message);status('Ringkasan disalin.');}catch(e){const range=document.createRange();range.selectNodeContents(q('[data-summary]'));const selection=window.getSelection();selection.removeAllRanges();selection.addRange(range);status('Ringkasan dipilih. Gunakan menu salin pada perangkat kamu.');}};q('form').onsubmit=e=>e.preventDefault();\nlet diary=[];q('[data-entry]').onclick=()=>{if(diary.length>=5){status('Lima catatan cukup untuk pesan awal.');return;}diary.push(v('area')+' · '+v('when')+' · '+(v('memo').trim()||'tanpa catatan tambahan'));q('[data-diary]').replaceChildren(...diary.map(x=>{let li=document.createElement('li');li.textContent=x;return li;}));update();};function compute(){return {title:'Catatan pemeriksaan Gigiku',lines:diary.length?diary:['Belum ada catatan ditambahkan.'],note:'Lokasi tercatat: Jl. Terusan Sutami No.41, Sukagalih. Jenis tindakan, jadwal dan biaya pemeriksaan: konfirmasi ke admin. Catatan membantu komunikasi dan tidak menilai tingkat penyakit.'};}resetExtra=()=>{diary=[];q('[data-diary]').replaceChildren();};\nupdate();\n})();\n</script>\n</section>",
 "nama": "Gigiku dental care"
