 "html": "<section id=\"khas\" class=\"khas\">\n<style>\n#khas{box-sizing:border-box;color:var(--ink);background:var(--bg);font:inherit;line-height:1.6;padding:clamp(20px,5vw,56px);border-top:1px solid var(--line);isolation:isolate}\n#khas *,#khas *::before,#khas *::after{box-sizing:border-box}\n#khas .wrap{max-width:1120px;margin-inline:auto}\n#khas .eyebrow{letter-spacing:.12em;text-transform:uppercase;font-size:.75rem;font-weight:700;margin:0 0 10px;color:var(--ink)}\n#khas h2{font:inherit;font-size:clamp(1.6rem,4vw,2.6rem);font-weight:750;line-height:1.2;max-width:800px;margin:0 0 16px;text-wrap:balance}\n#khas h3{font:inherit;font-size:1.1rem;font-weight:700;margin:0 0 12px}\n#khas p{margin:0 0 16px;overflow-wrap:anywhere}\n#khas .intro{max-width:760px;font-size:1.05rem}\n#khas .layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:24px;align-items:start;margin-top:28px}\n#khas .card{min-width:0;background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:clamp(16px,3vw,28px)}\n#khas .accent{border-top:4px solid var(--gold)}\n#khas .controls{display:grid;gap:18px}\n#khas label{display:grid;gap:7px;font-size:.95rem;font-weight:600;min-width:0}\n#khas input,#khas select,#khas textarea{font:inherit;color:var(--ink);background:var(--bg);width:100%;min-width:0;border:1px solid var(--line);border-radius:12px;padding:12px;min-height:48px}\n#khas input[type=range]{padding:8px 0;accent-color:var(--gold)}\n#khas input[type=checkbox]{width:20px;min-height:20px;height:20px;flex:none;accent-color:var(--gold)}\n#khas .check{display:flex;align-items:flex-start;gap:10px;font-weight:400;padding:9px 0}\n#khas fieldset{margin:0;border:1px solid var(--line);border-radius:16px;padding:16px;min-width:0}\n#khas legend{font-weight:700;padding:0 5px}\n#khas button,#khas .cta{font:inherit;font-weight:650;cursor:pointer;min-height:48px;border-radius:12px;border:1px solid var(--line);padding:12px 16px;color:var(--ink);background:var(--paper);text-align:center;white-space:normal;overflow-wrap:anywhere;touch-action:manipulation}\n#khas button:hover,#khas button[aria-pressed=true]{border-color:var(--gold);box-shadow:inset 0 0 0 2px var(--gold)}\n#khas button:disabled{opacity:.6;cursor:default}\n#khas .choices{display:flex;flex-wrap:wrap;gap:10px}\n#khas .choices button{flex:1 1 130px}\n#khas .cta{display:block;width:100%;background:var(--gold);border-color:var(--gold);margin-top:18px;text-decoration:none}\n#khas a:focus-visible,#khas button:focus-visible,#khas input:focus-visible,#khas select:focus-visible,#khas summary:focus-visible{outline:3px solid var(--ink);outline-offset:4px}\n#khas .result{white-space:pre-line;min-height:120px;overflow-wrap:anywhere;font-size:1rem}\n#khas .note{font-size:.84rem;line-height:1.55;margin-top:16px}\n#khas .facts{display:grid;gap:12px;margin-top:22px}\n#khas details{border-top:1px solid var(--line);padding-top:14px}\n#khas summary{cursor:pointer;font-weight:650;min-height:44px}\n#khas ul{padding-left:22px;margin:12px 0}\n#khas li{padding:3px 0;overflow-wrap:anywhere}\n#khas .steps{display:grid;gap:10px;padding:0;list-style:none}\n#khas .steps li{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px}\n#khas .visual{display:flex;flex-wrap:wrap;gap:10px;align-items:center;min-height:72px;padding:16px;border:1px solid var(--line);border-radius:16px;background:var(--bg)}\n#khas .visual span{display:inline-flex;align-items:center;justify-content:center;min-height:40px;border:1px solid var(--line);border-radius:10px;padding:8px 12px}\n#khas .visual span.on{border-color:var(--gold);box-shadow:inset 0 0 0 2px var(--gold)}\n#khas progress{width:100%;height:16px;accent-color:var(--gold)}\n#khas .two{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n#khas .small{font-size:.85rem}\n#khas .muted{opacity:.8}\n#khas [hidden]{display:none!important}\n#khas textarea{resize:vertical;min-height:90px}\n@media(max-width:680px){#khas .layout{grid-template-columns:1fr;gap:16px}#khas .two{grid-template-columns:1fr}#khas .card{border-radius:16px}#khas{padding:24px 16px}#khas .choices button{flex-basis:100px}}\n@media(prefers-reduced-motion:reduce){#khas *{scroll-behavior:auto;transition:none;animation:none}}\n</style>\n<!-- Dasar riset (bukan pemuatan file luar): https://raw.githubusercontent.com/jntmaximindo-ctrl/maxigrowth-previews/main/batches/B08/W684/riset.json | https://www.trustindex.io/reviews/qualitydentalcare.id | https://sites.google.com/rata.id/wiki/UMUM/klinik-rata/klinik-mitra-rata/jabodetabek | https://alamatsehat.com/quality-dental-care-jatibening-klinik-gigi-jatibening-drg-ferty-jl-caman-raya-bekasi/ | https://qualitydentalcare.id/ -->\n<div class=\"wrap\"><p class=\"eyebrow\">Quality Dental Care Jatibening · ruang persiapan kunjungan</p><h2>Kartu Jeda Kunjungan Caman</h2><p class=\"intro\">Quality tercatat memiliki dua sesi. Pilih waktu tiba lalu lihat apakah rencana Anda jatuh di sela sesi yang tercantum pada halaman mitra.</p>\n<div class=\"layout\"><div class=\"card\"><h3>Susun pilihan Anda</h3><div class=\"controls\"><label>Rencana tiba<input data-key=\"tiba\" type=\"time\" value=\"15:00\" ></label><label>Jika berada di jeda, saya ingin<select data-key=\"aksi\"><option value=\"Minta sesi pagi\">Minta sesi pagi</option><option value=\"Minta sesi sore\">Minta sesi sore</option><option value=\"Minta alternatif hari\">Minta alternatif hari</option></select></label></div><div class=\"visual\" data-visual aria-live=\"polite\"></div><p class=\"note\">Pilihan ini hanya membantu menyusun pertanyaan. Anda belum melakukan pemesanan dan tidak perlu memasukkan identitas atau riwayat kesehatan pribadi.</p><button type=\"button\" data-reset>Mulai lagi</button></div>\n<div class=\"card accent\"><h3>Ringkasan untuk admin</h3><div class=\"result\" data-result role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></div><a class=\"cta\" data-wa href=\"https://wa.me/{{WA}}?text=Halo\" target=\"_blank\" rel=\"noopener noreferrer\">Tanyakan lewat WhatsApp ↗</a><p class=\"note\">Pesan disiapkan di WhatsApp; Anda dapat membacanya dan mengubahnya sebelum mengirim. Jadwal baru pasti setelah admin memberikan konfirmasi.</p><div class=\"facts\"><details><summary>Dasar informasi &amp; hal yang perlu dikonfirmasi</summary><ul><li>Sesi dari halaman mitra RATA bukan jadwal pasti dokter. Lokasi 84 perlu konfirmasi karena direktori lama berbeda.</li><li>Lokasi tercatat: Jl. Caman Raya No.84, RT.007/RW.003, Jatibening, Pondok Gede, Kota Bekasi 17412. Konfirmasi titik kunjungan sebelum berangkat.</li><li>Profil dokter aktif belum terverifikasi dalam data yang tersedia. Minta nama dan jadwal dokter kepada admin.</li></ul><p class=\"small\">Informasi dapat berubah. Jika rincian belum tersedia, konfirmasi ke admin; jangan menganggap pilihan di sini sebagai jadwal langsung atau paket perawatan.</p></details><details><summary>Bagaimana memakai ringkasan ini?</summary><ol class=\"steps\"><li>Pilih rencana atau pertanyaan yang sesuai kebutuhan Anda.</li><li>Baca ringkasan yang berubah mengikuti pilihan. Gunakan “Mulai lagi” bila ingin mengulang.</li><li>Buka WhatsApp untuk menanyakan jadwal dan rincian; keputusan perawatan memerlukan pemeriksaan dokter.</li></ol></details></div></div></div>\n<noscript><p>Aktifkan JavaScript untuk menyusun ringkasan. Anda tetap dapat memakai tombol WhatsApp untuk bertanya langsung ke admin.</p></noscript></div>\n<script>(()=>{'use strict';const clinic=\"Quality Dental Care Jatibening\";const hours={\"sen\": \"09:30-14,16-20\", \"sel\": \"09:30-14,16-20\", \"rab\": \"09:30-14,16-20\", \"kam\": \"09:30-14,16-20\", \"jum\": \"09:30-14,16-20\", \"sab\": \"09:30-14,16-20\"};\nconst root=document.currentScript.closest('section');\nconst $=s=>root.querySelector(s),all=s=>Array.from(root.querySelectorAll(s));\nconst val=k=>{const e=$('[data-key=\"'+k+'\"]');return e?(e.type==='time'?(e.value||e.defaultValue||'12:00'):e.value):(picked[k]||'Belum dipilih');};\nconst list=k=>all('[data-list=\"'+k+'\"]:checked').map(e=>e.value);\nconst picked=Object.create(null);let message='';\nconst result=$('[data-result]'),wa=$('[data-wa]');\nconst show=(text)=>{message=text;result.textContent=text;wa.href='https://wa.me/{{WA}}?text='+encodeURIComponent('Halo '+clinic+'. Saya ingin bertanya:\\n'+text+'\\nMohon konfirmasi ke admin: jadwal, ketersediaan, dan biaya yang berlaku.');};\nconst dayKeys=['sen','sel','rab','kam','jum','sab','min'];\nconst dayNames=['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Minggu'];\nconst schedule=d=>hours&&hours[dayKeys[dayNames.indexOf(d)]]||'Belum terverifikasi';\nconst fmt=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(n);\nconst badge=text=>{$('[data-visual]').textContent=text;};\nroot.addEventListener('click',e=>{const b=e.target.closest('[data-choice]');if(!b||!root.contains(b))return;const k=b.dataset.choice;picked[k]=b.dataset.value;all('[data-choice=\"'+k+'\"]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));update();});\nroot.addEventListener('input',e=>{if(e.target.matches('input,select,textarea'))update();});\nroot.addEventListener('change',e=>{if(e.target.matches('input,select,textarea'))update();});\n$('[data-reset]').addEventListener('click',()=>{all('input,textarea').forEach(e=>{if(e.type==='checkbox')e.checked=e.defaultChecked;else e.value=e.defaultValue;});all('select').forEach(e=>e.selectedIndex=0);Object.keys(picked).forEach(k=>delete picked[k]);all('[data-choice]').forEach(e=>e.setAttribute('aria-pressed','false'));update();});\n\nfunction update(){const p=val('tiba').split(':').map(Number),m=p[0]*60+p[1],gap=m>=840&&m<960;badge(gap?'Jeda 14.00–16.00':'Periksa sesi yang tercantum');show('Quality Dental Care Jatibening — rencana tiba '+val('tiba')+'.\\nSesi tercatat 09.30–14.00 dan 16.00–20.00, Senin–Sabtu. '+(gap?'Pilihan jatuh di jeda dua sesi.':m>=570&&m<840||m>=960&&m<1200?'Pilihan berada dalam rentang sesi tercatat.':'Pilihan berada di luar rentang sesi tercatat.')+'\\nAlternatif yang saya inginkan: '+val('aksi')+'.\\nAlamat acuan terbaru dalam riset: Caman Raya No.84, berbeda dari No.23b pada direktori lama. Konfirmasi ke admin sesi dan alamat terbaru.');}\nupdate();})();</script>\n</section>",
 "nama": "Quality Dental Care Jatibening"
}