 ],
 "html": "<section id=\"khas\" class=\"khas\" aria-label=\"Rak Pertanyaan Perawatan\">\n<style>\n#khas{font-family:inherit;color:var(--ink);background:var(--bg);padding:clamp(24px,5vw,64px) clamp(16px,4vw,48px);isolation:isolate}\n#khas *{box-sizing:border-box}#khas .wrap{max-width:1120px;margin:auto}#khas .eyebrow{display:flex;align-items:center;gap:8px;font-size:.78rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--ink);margin:0 0 14px}\n#khas .dot{width:10px;height:10px;border-radius:50%;background:var(--gold);display:inline-block}#khas h2{font-size:clamp(1.65rem,4vw,2.65rem);line-height:1.15;margin:0 0 16px;max-width:760px;letter-spacing:-.025em}#khas h3{font-size:1.12rem;line-height:1.4;margin:0 0 12px}#khas p{line-height:1.65;margin:0 0 16px}#khas .intro{max-width:760px;font-size:1.02rem}\n#khas .layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:22px;align-items:start;margin-top:28px}#khas .panel{background:var(--paper);border:1px solid var(--line);border-radius:24px;padding:clamp(18px,3vw,30px);min-width:0}#khas .result{border-top:5px solid var(--gold)}#khas .label{font-size:.76rem;letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px;font-weight:700}#khas .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}#khas .field{display:grid;gap:8px;font-size:.9rem;font-weight:600;margin-bottom:16px;min-width:0}\n#khas input,#khas select,#khas textarea{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px;min-width:0;width:100%;max-width:100%;min-height:46px}#khas textarea{resize:vertical;min-height:90px}#khas input[type=checkbox]{width:20px;height:20px;min-height:20px;accent-color:var(--gold);flex-shrink:0;margin:2px 0}#khas input[type=range]{padding:8px 0;accent-color:var(--gold);border:0;background:transparent}\n#khas button,#khas a.cta{font:inherit;font-weight:650;line-height:1.35;cursor:pointer;color:var(--ink);border:1px solid var(--line);background:var(--paper);padding:12px 15px;border-radius:12px;min-height:46px;white-space:normal;text-align:left;overflow-wrap:anywhere}#khas button:hover{border-color:var(--gold)}#khas button[aria-pressed=true]{border:2px solid var(--gold);padding:11px 14px;background:var(--bg)}#khas button:focus-visible,#khas a:focus-visible,#khas input:focus-visible,#khas select:focus-visible,#khas summary:focus-visible{outline:3px solid var(--gold);outline-offset:4px}#khas .choices{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}#khas .choices button{flex:1 1 130px}#khas .checks{display:grid;gap:10px;margin:14px 0 20px}#khas .checks label{display:flex;gap:10px;border:1px solid var(--line);border-radius:12px;padding:12px;line-height:1.5;background:var(--bg)}\n#khas .readout{font-size:1.05rem;line-height:1.7;white-space:pre-line;overflow-wrap:anywhere;min-height:130px}#khas .note{font-size:.84rem;line-height:1.6;border-left:3px solid var(--gold);padding-left:12px;margin-top:16px}#khas .cta{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-decoration:none;background:var(--gold)!important;border-color:var(--gold)!important;margin-top:20px}#khas .cta svg{width:20px;height:20px;flex-shrink:0}#khas .toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}#khas .toolbar button{font-size:.84rem;flex:1 1 110px}#khas .status{font-size:.83rem;min-height:22px;margin:10px 0 0}#khas .fact{border:1px solid var(--line);padding:14px 16px;border-radius:14px;margin:12px 0;background:var(--bg);line-height:1.6;overflow-wrap:anywhere}#khas .fact strong{display:block;margin-bottom:4px}#khas .big{font-size:clamp(1.6rem,4vw,2.5rem);font-weight:700;letter-spacing:-.03em}#khas .meter{height:9px;overflow:hidden;background:var(--line);border-radius:20px;margin:10px 0 18px}#khas .meter span{display:block;height:100%;width:0;background:var(--gold);transition:width .2s}#khas details{margin-top:24px;border-top:1px solid var(--line);padding-top:14px;font-size:.83rem}#khas summary{cursor:pointer;font-weight:600;line-height:1.6;padding:6px 0}#khas details ul{padding-left:20px;line-height:1.7}#khas details a{color:var(--ink);overflow-wrap:anywhere}#khas .steps{list-style:none;padding:0;display:grid;gap:12px;margin:16px 0}#khas .steps li{padding:14px;border:1px solid var(--line);border-radius:12px;line-height:1.55}#khas .badge{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:5px 10px;font-size:.78rem;margin:0 5px 8px 0}#khas .cards{display:grid;gap:10px;margin-bottom:18px}#khas .cards button{width:100%}#khas .address{font-size:1.05rem;line-height:1.65}#khas .inline{display:flex;gap:10px;align-items:center;flex-wrap:wrap}\n@media(max-width:700px){#khas .layout{grid-template-columns:1fr;gap:16px}#khas .grid{grid-template-columns:1fr}#khas .panel{border-radius:18px}#khas h2{max-width:100%}#khas .readout{min-height:100px}#khas .choices button{flex-basis:120px}}@media(prefers-reduced-motion:reduce){#khas .meter span{transition:none}}\n</style>\n<div class=\"wrap\"><p class=\"eyebrow\"><span class=\"dot\" aria-hidden=\"true\"></span>IGGI Dental Cab. Citraland</p><h2>Rak Pertanyaan Perawatan</h2><p class=\"intro\">Pilih layanan yang ingin Anda pahami di IGGI Citraland, lalu pilih sudut pertanyaannya. Alat ini membuat agenda percakapan, bukan menentukan perawatan.</p>\n<div class=\"layout\"><div class=\"panel\"><p class=\"label\">Coba sesuai kebutuhan Anda</p><div class=\"checks\"><label><input type=\"checkbox\" data-check value=\"Perawatan gigi anak\"><span>Perawatan gigi anak</span></label><label><input type=\"checkbox\" data-check value=\"Perawatan saluran akar\"><span>Perawatan saluran akar</span></label><label><input type=\"checkbox\" data-check value=\"Behel dan aligner\"><span>Behel dan aligner</span></label><label><input type=\"checkbox\" data-check value=\"Bleaching\"><span>Bleaching</span></label><label><input type=\"checkbox\" data-check value=\"Veneer\"><span>Veneer</span></label><label><input type=\"checkbox\" data-check value=\"Gigi tiruan\"><span>Gigi tiruan</span></label><label><input type=\"checkbox\" data-check value=\"Pencabutan dan operasi gigi\"><span>Pencabutan dan operasi gigi</span></label></div><div class=\"choices\" role=\"group\" aria-label=\"Pilihan\"><button type=\"button\" data-choice=\"angle\" data-value=\"Tahapan pemeriksaan\" aria-pressed=\"false\">Tahapan pemeriksaan</button><button type=\"button\" data-choice=\"angle\" data-value=\"Pilihan dan perbedaan\" aria-pressed=\"false\">Pilihan dan perbedaan</button><button type=\"button\" data-choice=\"angle\" data-value=\"Rincian komponen biaya\" aria-pressed=\"false\">Rincian komponen biaya</button></div><div class=\"fact\"><strong>Tujuan cabang</strong>Citraland · Ruko North Junction Blok RB12</div></div>\n<aside class=\"panel result\"><p class=\"label\">Ringkasan untuk admin</p><div class=\"readout\" aria-live=\"polite\" aria-atomic=\"true\"></div><p class=\"note\">Pilihan ini membantu percakapan awal. Bukan diagnosis, rekomendasi tindakan, atau konfirmasi reservasi. Jadwal dan informasi terbaru perlu konfirmasi ke admin.</p><a class=\"cta\" href=\"https://wa.me/{{WA}}?text=Halo\" target=\"_blank\" rel=\"noopener noreferrer\"><span>Tanyakan lewat WhatsApp</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a><div class=\"toolbar\"><button type=\"button\" data-action=\"copy\">Salin pesan</button><button type=\"button\" data-action=\"reset\">Atur ulang</button></div><p class=\"status\" role=\"status\"></p></aside></div>\n<details><summary>Dasar informasi &amp; hal yang perlu dikonfirmasi</summary><p>Layanan dalam pilihan terdapat pada riset dan situs resmi IGGI yang dibuka ulang. Ketersediaan dokter, jadwal dan layanan di cabang Citraland tetap perlu konfirmasi; daftar jaringan tidak otomatis menjamin setiap layanan tersedia di setiap cabang.</p><p>Data dasar: riset klinik bertanggal 10 Oktober 2026. Informasi kosong tidak dianggap sebagai layanan yang tersedia. Hubungi admin untuk pembaruan.</p><ul><li><a href=\"https://raw.githubusercontent.com/jntmaximindo-ctrl/maxigrowth-previews/main/batches/B08/W759/riset.json\" target=\"_blank\" rel=\"noopener noreferrer\">Baca data riset klinik</a></li><li><a href=\"https://iggidental.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Sumber data 1</a></li><li><a href=\"https://iggidental.com/mitos-atau-fakta-scaling-menyebabkan-gigi-menjadi-tipis/\" target=\"_blank\" rel=\"noopener noreferrer\">Sumber data 2</a></li></ul></details>\n<noscript><p>Interaksi memerlukan JavaScript. Silakan hubungi admin melalui tombol WhatsApp untuk konfirmasi kunjungan.</p></noscript></div>\n<script>(()=>{'use strict';const CONFIG={\"name\": \"IGGI Dental Cab. Citraland\", \"title\": \"Rak Pertanyaan Perawatan\", \"hours\": {}, \"address\": \"Ruko North Junction, Jl. Taman Puspa Raya Blok RB12, Sambikerep, Surabaya\", \"doctors\": []};\nconst root=document.currentScript.closest('section');\nif(!root||root.dataset.ready)return;root.dataset.ready='1';\nconst q=s=>root.querySelector(s),qa=s=>Array.from(root.querySelectorAll(s));\nconst state={};const val=k=>{const e=q('[data-key=\"'+k+'\"]');return e?e.value:(state[k]||'');};\nconst selected=()=>qa('[data-check]:checked').map(e=>e.value);\nconst output=q('.readout'),link=q('.cta'),status=q('.status');\nlet message='';const clinic=CONFIG.name;\nconst show=(text)=>{output.textContent=text;message='Halo '+clinic+', saya menggunakan fitur '+CONFIG.title+'.\\n'+text+'\\nMohon konfirmasi informasi terbaru, jadwal dokter, ketersediaan dan biaya sebelum kunjungan. Terima kasih.';link.setAttribute('href','https://wa.me/{{WA}}?text='+encodeURIComponent(message));};\nconst fieldChanged=()=>{status.textContent='';update();};\nroot.addEventListener('input',fieldChanged);root.addEventListener('change',fieldChanged);\nroot.addEventListener('click',e=>{const b=e.target.closest('button');if(!b||!root.contains(b))return;\nif(b.dataset.choice){const key=b.dataset.choice;state[key]=b.dataset.value;qa('[data-choice=\"'+key+'\"]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));fieldChanged();}\nif(b.dataset.action==='reset'){qa('input').forEach(x=>{if(x.type==='checkbox')x.checked=false;else x.value=x.defaultValue;});qa('select').forEach(x=>x.selectedIndex=0);qa('textarea').forEach(x=>x.value='');Object.keys(state).forEach(k=>delete state[k]);qa('[data-choice]').forEach(x=>x.setAttribute('aria-pressed','false'));update();status.textContent='Pilihan sudah diatur ulang.';}\nif(b.dataset.action==='copy'){if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(message).then(()=>status.textContent='Pesan disalin. Anda bisa meninjaunya sebelum dikirim.').catch(()=>status.textContent='Penyalinan tidak tersedia. Pilih teks ringkasan, atau buka WhatsApp.');}else{status.textContent='Pilih teks ringkasan untuk menyalin, atau buka WhatsApp.';}}\n});\nfunction dateLabel(v){if(!v)return 'tanggal belum dipilih';const d=new Date(v+'T12:00:00');return new Intl.DateTimeFormat('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(d);}\nfunction dayCode(v){if(!v)return null;return ['min','sen','sel','rab','kam','jum','sab'][new Date(v+'T12:00:00').getDay()];}\nfunction minutes(t){if(!t)return null;const a=t.split(':').map(Number);return a[0]*60+a[1];}\nfunction hh(n){return String(Math.floor(n/60)).padStart(2,'0')+'.'+String(n%60).padStart(2,'0');}\nfunction hoursFor(date){const code=dayCode(date);return code?(CONFIG.hours[code]||'belum tercatat'):'pilih tanggal';}\nfunction within(date,time){const h=hoursFor(date),m=minutes(time);if(!date||m===null)return 'Pilih tanggal dan waktu yang Anda inginkan.';if(h==='tutup')return 'Hari ini tercatat tutup. Pilih hari lain lalu konfirmasi ke admin.';if(h==='belum tercatat')return 'Jam hari ini belum tercatat; konfirmasi ke admin.';const ok=h.split(',').some(s=>{const a=s.split('-').map(Number);return m>=a[0]*60&&m<a[1]*60;});return ok?'Waktu pilihan berada dalam jam praktik yang tercatat. Slot belum dikonfirmasi.':'Waktu pilihan di luar jam praktik yang tercatat. Minta alternatif ke admin.';}\n\nfunction update(){const list=selected();show('Rak pertanyaan IGGI Citraland\\n'+(list.length?list.map((x,i)=>(i+1)+'. '+x+' — '+(val('angle')||'penjelasan awal')).join('\\n'):'Pilih satu atau beberapa layanan yang ingin dibahas.')+'\\nMohon jelaskan apakah layanan pilihan tersedia di cabang Citraland, siapa dokternya, dan biaya pemeriksaannya.\\nLokasi: '+CONFIG.address+'\\nSaya memahami pilihan tindakan memerlukan pemeriksaan dokter.');}\nconst updateFeature=update;update=function(){const emptyTimes=qa('input[type=\"time\"]').filter(e=>!e.value);if(emptyTimes.length){const display=q('[data-display]');if(display)display.textContent='Pilih waktu terlebih dahulu';show('Waktu belum lengkap. Silakan pilih waktu rencana, lalu konfirmasi ke admin.\\nTujuan: '+CONFIG.address);return;}updateFeature();};\nupdate();})();</script>\n</section>",
 "nama": "IGGI Dental Cab. Citraland"
}