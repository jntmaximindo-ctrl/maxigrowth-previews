{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": ["tanggal", "ide"],
 "properties": {
  "tanggal": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "ide": {
   "type": "array", "minItems": 1, "maxItems": 8,
   "items": {
    "type": "object",
    "required": ["id", "nama", "masalah_pasien", "solusi", "alur_pengguna", "referensi", "skor", "risiko_permenkes", "butuh_data"],
    "properties": {
     "id": {"type": "string", "pattern": "^[a-z0-9-]{3,40}$"},
     "nama": {"type": "string", "minLength": 3},
     "masalah_pasien": {"type": "string", "minLength": 20},
     "solusi": {"type": "string", "minLength": 20},
     "alur_pengguna": {"type": "array", "minItems": 2, "items": {"type": "string"}},
     "referensi": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["nama", "url"], "properties": {"nama": {"type": "string"}, "url": {"type": "string", "pattern": "^https?://"}}}},
     "skor": {"type": "object", "required": ["manfaat", "kemudahan", "keunikan", "aman_permenkes"],
              "properties": {"manfaat": {"type": "integer", "minimum": 1, "maximum": 5}, "kemudahan": {"type": "integer", "minimum": 1, "maximum": 5},
                             "keunikan": {"type": "integer", "minimum": 1, "maximum": 5}, "aman_permenkes": {"type": "integer", "minimum": 1, "maximum": 5}}},
     "risiko_permenkes": {"type": "string"},
     "butuh_data": {"type": "array", "items": {"type": "string"}}
    }
   }
  }
 }
}
